# Copie para .env e preencha com os valores do seu projeto Supabase
# (Project Settings > API). O arquivo .env NAO deve ser versionado.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Edge Functions (Supabase → Project Settings → Edge Functions → Secrets)
# Removemos o Lovable. Use Gemini (AI Studio) ou OpenAI:
# GEMINI_API_KEY=
# OPENAI_API_KEY=
#
# Google Meet (provision-meeting): conta host conecta OAuth no app
# (membrosliberty@gmail.com). Scopes Meet já vão no google-oauth-start.
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET (já usados no Calendar)
